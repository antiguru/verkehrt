# Sums of an integer array combined with a broadcast scalar. The planner moves the scalar out
# of the `i64` and `u64` sums, and the values overflow each width, so the outputs pin that
# the rewritten plans wrap exactly like the elementwise ones.

# i64
run
let a = [9223372036854775807, 9223372036854775807, 5, (-9223372036854775808)];
let k = 9223372036854775807;
print(sum(a + k));
print(sum(k + a));
print(sum(a - k));
print(sum(k - a));
print(sum(a * k));
print(sum(k * a));
print(sum(filter(a, |v| v == 1) + k));
print(sum(k - filter(a, |v| v == 1)));
----
9223372036854775807
9223372036854775807
-9223372036854775801
9223372036854775801
-3
-3
0
0

# u64
run
let a = [18446744073709551615u64, 18446744073709551615u64, 5u64];
let k = 18446744073709551615u64;
print(sum(a + k));
print(sum(k + a));
print(sum(a - k));
print(sum(k - a));
print(sum(a * k));
print(sum(k * a));
----
0
0
6
18446744073709551610
18446744073709551613
18446744073709551613

# i32
run
let a = [2147483647i32, 2147483647i32, 5i32, (-2147483648i32)];
let k = 2147483647i32;
print(sum(a + k));
print(sum(k + a));
print(sum(a - k));
print(sum(k - a));
print(sum(a * k));
print(sum(k * a));
----
-2147483649
-2147483649
-2147483641
2147483641
-3
-3

# u8
run
let a = [255u8, 255u8, 5u8];
let k = 255u8;
print(sum(a + k));
print(sum(k + a));
print(sum(a - k));
print(sum(k - a));
print(sum(a * k));
print(sum(k * a));
----
512
512
6
250
253
253
