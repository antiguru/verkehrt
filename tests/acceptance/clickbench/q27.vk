// sql: SELECT CounterID, AVG(octet_length(URL)) AS l, COUNT(*) AS c FROM hits WHERE URL <> '' GROUP BY CounterID
// sql:   HAVING COUNT(*) > 1000 ORDER BY l DESC, CounterID LIMIT 25
// output: [u,f,u]
input CounterID: i64[];
input URL_ends: i64[];

// A row's length is the difference of its end offset and the previous one, and an empty URL has
// length 0, so URL <> '' is len > 0.
let len = URL_ends - prev(URL_ends, 0);
let keep = len > 0;
let c = compress(CounterID, keep);
let l = compress(len, keep);
// A key with a small range becomes a bucket index by subtracting its minimum, and the bucket count
// comes from the shifted keys. An empty filter has no groups.
let base = if length(c) > 0 { reduce(c, min) } else { 0 };
let shifted = c - base;
let nb = if length(shifted) > 0 { reduce(shifted, max) + 1 } else { 0 };
let counts = histogram(shifted, nb);
let sums = reduce_into(shifted, l, nb, add);
// HAVING COUNT(*) > 1000. `where` lists the surviving buckets in ascending CounterID order.
let groups = where(counts > 1000);
let n = gather(counts, groups);
let avg = cast_f64(gather(sums, groups)) / cast_f64(n);
// `argsort` has no kernel for f64, so the sort key is the average scaled by 2^44 and truncated to
// i64. The scaling is exact, so the key keeps the order of any two averages that differ by 2^-44
// or more, and averages below 2^19 do not overflow. A stable sort on the negated key puts the
// largest first and breaks ties by CounterID.
let order = argsort(0 - cast_i64(avg * 17592186044416.0));
let top = slice(order, 0, min(length(order), 25));
export CounterID = gather(groups, top) + base;
export l = gather(avg, top);
export c = gather(n, top);
