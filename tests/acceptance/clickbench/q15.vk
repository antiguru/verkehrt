// sql: SELECT UserID, COUNT(*) AS c FROM hits GROUP BY UserID ORDER BY c DESC, UserID LIMIT 10
// output: [i,u]
input UserID: i64[];

// Group by sorting. A row starts a group when its id differs from the previous row, or when it is
// the first row. An empty column gives no groups and empty outputs.
let s = gather(UserID, argsort(UserID));
let n = length(s);
let start = or(s != prev(s, 0), iota(n) == 0);
let ng = count(start);
let gid = scan(cast_i64(start), add) - 1;
let counts = reduce_into(gid, (gid * 0) + 1, ng, add);
let gk = compress(s, start);
// The groups are in UserID order, so a stable sort on descending counts breaks ties by id.
let order = argsort(0 - counts);
let top = slice(order, 0, min(ng, 10));
export UserID = gather(gk, top);
export c = gather(counts, top);
