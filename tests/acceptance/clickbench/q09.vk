// sql: SELECT RegionID, SUM(AdvEngineID), COUNT(*) AS c, AVG(ResolutionWidth), COUNT(DISTINCT UserID) FROM hits
// sql:   GROUP BY RegionID ORDER BY c DESC, RegionID LIMIT 10
// output: [u,u,u,f,u]
input RegionID: i64[];
input AdvEngineID: i64[];
input ResolutionWidth: i64[];
input UserID: i64[];

// `group_id` of the pair numbers each distinct (RegionID, UserID) pair once. The region id of each
// pair, counted per region, is the distinct user count. An empty column gives no groups and empty
// outputs.
let g = group_id(RegionID);
let ng = if length(g) > 0 { reduce(g, max) + 1 } else { 0 };
let p = group_id(RegionID, UserID);
let np = if length(p) > 0 { reduce(p, max) + 1 } else { 0 };
let users = histogram(reduce_into(p, g, np, min), ng);
let counts = histogram(g, ng);
let advs = reduce_into(g, AdvEngineID, ng, add);
let widths = reduce_into(g, ResolutionWidth, ng, add);
// Every row of a group has the same region, so the minimum recovers it.
let gr = reduce_into(g, RegionID, ng, min);
// Sorting the groups by region and then stably by descending counts breaks ties by region.
let ko = argsort(gr);
let co = argsort(0 - gather(counts, ko));
let top = gather(ko, slice(co, 0, min(ng, 10)));
let tc = gather(counts, top);
export RegionID = gather(gr, top);
export AdvEngineID = gather(advs, top);
export c = tc;
export ResolutionWidth = cast_f64(gather(widths, top)) / cast_f64(tc);
export u = gather(users, top);
