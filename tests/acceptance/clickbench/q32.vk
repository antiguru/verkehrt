// sql: SELECT WatchID, ClientIP, COUNT(*) AS c, SUM(IsRefresh), AVG(ResolutionWidth) FROM hits
// sql:   GROUP BY WatchID, ClientIP ORDER BY c DESC, WatchID, ClientIP LIMIT 10
// output: [i,i,u,u,f]
input WatchID: i64[];
input ClientIP: i64[];
input IsRefresh: i64[];
input ResolutionWidth: i64[];

// Group by hashing. `group_id` of the two keys gives each row the dense id of its (WatchID,
// ClientIP) pair, numbered by first occurrence. An empty input gives no groups and empty outputs.
let ids = group_id(WatchID, ClientIP);
let ng = if length(ids) > 0 { reduce(ids, max) + 1 } else { 0 };
let counts = histogram(ids, ng);
let refreshes = reduce_into(ids, IsRefresh, ng, add);
let widths = reduce_into(ids, ResolutionWidth, ng, add);
// Every row of a group has the same keys, so the minimum recovers them.
let gk = reduce_into(ids, WatchID, ng, min);
let gip = reduce_into(ids, ClientIP, ng, min);
// Sorting the groups by (WatchID, ClientIP) takes two stable passes, minor key first. The stable
// sort on descending counts then breaks ties by key.
let o1 = argsort(gip);
let o2 = argsort(gather(gk, o1));
let ko = gather(o1, o2);
let co = argsort(0 - gather(counts, ko));
let top = gather(ko, slice(co, 0, min(ng, 10)));
let tc = gather(counts, top);
export WatchID = gather(gk, top);
export ClientIP = gather(gip, top);
export c = tc;
export IsRefresh = gather(refreshes, top);
export ResolutionWidth = cast_f64(gather(widths, top)) / cast_f64(tc);
