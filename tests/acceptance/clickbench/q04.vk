// sql: SELECT COUNT(DISTINCT UserID) FROM hits
// output: u
input UserID: i64[];

// The number of groups is the largest id plus one. `reduce` rejects an empty array, so a single
// bucket (every key 0) holds the maximum instead. It is the identity for an empty array, which
// clamps to 0.
fn groups(ids: i64[]) -> i64 { max(reduce(reduce_into(ids * 0, ids, 1, max), max) + 1, 0) }

// `group_id` numbers each distinct id once, densely from 0, so the distinct count is the largest id
// plus one. An empty column has no ids, so the count is clamped to 0.
let g = group_id(UserID);
export u = groups(g);
