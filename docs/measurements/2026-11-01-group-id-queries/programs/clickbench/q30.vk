// sql: SELECT SearchEngineID, ClientIP, COUNT(*) AS c, SUM(IsRefresh), AVG(ResolutionWidth) FROM hits WHERE SearchPhrase <> ''
// sql:   GROUP BY SearchEngineID, ClientIP ORDER BY c DESC, SearchEngineID, ClientIP LIMIT 10
// output: [u,i,u,u,f]
input SearchEngineID: i64[];
input ClientIP: i64[];
input IsRefresh: i64[];
input ResolutionWidth: i64[];
input SearchPhrase_ends: i64[];

// A row's phrase length is the difference of its end offset and the previous one, and
// SearchPhrase <> '' means that length is nonzero.
let keep = (SearchPhrase_ends - prev(SearchPhrase_ends, 0)) > 0;
let k0 = compress(SearchEngineID, keep);
let ip0 = compress(ClientIP, keep);
let r0 = compress(IsRefresh, keep);
let w0 = compress(ResolutionWidth, keep);
// Group by hashing. `group_id` of the two keys gives each row the dense id of its (SearchEngineID,
// ClientIP) pair, numbered by first occurrence. An empty filter gives no rows, no groups, and empty
// outputs.
let ids = group_id(k0, ip0);
let ng = if length(ids) > 0 { reduce(ids, max) + 1 } else { 0 };
let counts = histogram(ids, ng);
let refreshes = reduce_into(ids, r0, ng, add);
let widths = reduce_into(ids, w0, ng, add);
// Every row of a group has the same keys, so the minimum recovers them.
let gk = reduce_into(ids, k0, ng, min);
let gip = reduce_into(ids, ip0, ng, min);
// Sorting the groups by (SearchEngineID, ClientIP) takes two stable passes, minor key first. The
// stable sort on descending counts then breaks ties by key.
let o1 = argsort(gip);
let o2 = argsort(gather(gk, o1));
let ko = gather(o1, o2);
let co = argsort(0 - gather(counts, ko));
let top = gather(ko, slice(co, 0, min(ng, 10)));
let tc = gather(counts, top);
export SearchEngineID = gather(gk, top);
export ClientIP = gather(gip, top);
export c = tc;
export IsRefresh = gather(refreshes, top);
export ResolutionWidth = cast_f64(gather(widths, top)) / cast_f64(tc);
