# div_const needs a uniform divisor, which the checker tracks through lambdas and functions.

# div_const_rejects_an_array_divisor
type
let x = [1, 2]; let y = div_const(x, x);
----
error: no kernel for 'div_const' on i64[], i64[] at 1:25

# div_const_in_a_lambda_rejects_a_parameter_divisor
# Lifted over arrays, a parameter divisor is an array, which the kernel does not take.
type
let x = [1, 2]; let m = map(x, |v| div_const(v, v));
----
error: no kernel for 'div_const' on i64[], i64[] at 1:36

# div_const_in_a_lambda_rejects_a_constant_dividend_with_a_parameter_divisor
type
let x = [1, 2]; let m = map(x, |v| div_const(60, v));
----
error: no kernel for 'div_const' on i64, i64[] at 1:36

# div_const_in_a_lambda_rejects_a_divisor_derived_from_a_parameter
type
let x = [1, 2]; let m = map(x, |v| { let d = v + 1; div_const(v, d) });
----
error: no kernel for 'div_const' on i64[], i64[] at 1:53

type
let x = [1, 2]; let m = map(x, |v| div_const(v, v + 1));
----
error: no kernel for 'div_const' on i64[], i64[] at 1:36

# div_const_in_a_lambda_accepts_a_constant_or_captured_divisor
type
let x = [1, 2]; let m = map(x, |v| div_const(v, 60));
----
i64[]

type
let x = [1, 2]; let k = 7; let m = map(x, |v| div_const(v + 1, k));
----
i64[]

# A block let that does not read the parameter stays uniform.
type
let x = [1, 2]; let m = map(x, |v| { let d = 3 + 4; div_const(v, d) });
----
i64[]

# div_const_in_a_function_called_from_a_lambda_with_a_constant_divisor
type
fn f(a: i64, b: i64) -> i64 { div_const(a, b) } let m = map([1, 2], |v| f(v, 3));
----
i64[]

# div_const_in_a_function_called_from_a_lambda_with_a_parameter_divisor
type
fn f(a: i64, b: i64) -> i64 { div_const(a, b) } let m = map([1, 2], |v| f(v, v));
----
error: no kernel for 'div_const' on i64[], i64[] (in 'f' at 1:31) at 1:73

type
fn f(a: i64, b: i64) -> i64 { div_const(a, b) } let m = map([1, 2], |v| f(3, v));
----
error: no kernel for 'div_const' on i64, i64[] (in 'f' at 1:31) at 1:73

# function_is_checked_per_uniformity_pattern
# The same function is fine with a constant divisor and rejected with a varying one.
type
fn f(a: i64, b: i64) -> i64 { div_const(a, b) } let m = map([1, 2], |v| f(v, 3) + f(v, v));
----
error: no kernel for 'div_const' on i64[], i64[] (in 'f' at 1:31) at 1:83

# Outside a lambda the function is checked as before.
type
fn f(a: i64, b: i64) -> i64 { div_const(a, b) } let r = f(7, 7);
----
i64

# div_const_through_a_function_chain
type
fn g(a: i64, b: i64) -> i64 { div_const(a, b) } fn f(a: i64, b: i64) -> i64 { g(a + 1, b) }  let m = map([1, 2], |v| f(v, 3));
----
i64[]

type
fn g(a: i64, b: i64) -> i64 { div_const(a, b) } fn f(a: i64, b: i64) -> i64 { g(a + 1, b) }  let c = 5; let m = map([1, 2], |v| f(v, c * 2));
----
i64[]

type
fn g(a: i64, b: i64) -> i64 { div_const(a, b) } fn f(a: i64, b: i64) -> i64 { g(a + 1, b) }  let m = map([1, 2], |v| f(v, v));
----
error: no kernel for 'div_const' on i64[], i64[] (in 'g' at 1:31) (in 'f' at 1:79) at 1:118

# function_name_as_lambda_is_checked_with_a_varying_parameter
type
fn f(a: i64) -> i64 { div_const(a, 60) } let m = map([1, 2], f);
----
i64[]

type
fn f(a: i64) -> i64 { div_const(60, a) } let m = map([1, 2], f);
----
error: no kernel for 'div_const' on i64, i64[] (in 'f' at 1:23) at 1:62

# lambda_inside_a_function_body_is_checked_lifted
type
fn f(x: i64[]) -> i64[] { map(x, |v| div_const(60, v)) } let r = f([1, 2]);
----
error: no kernel for 'div_const' on i64, i64[] at 1:38
