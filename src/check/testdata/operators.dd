# Operators, kernels, conditionals, annotations, and the host interface.

# elementwise_array_scalar
type
let x = [1.0, 2.0]; let y = x * 2.0;
----
f64[]

# no_implicit_conversion_at_operator
type
let x = [1.0]; let y = x * 2;
----
error: no implicit conversion: f64[] * i64 at 1:26

# no_kernel
type
let x = [1i8]; let y = x * x;
----
error: no kernel for '*' on i8[], i8[] at 1:26

# and_on_f64_has_no_kernel
type
let x = [1.0]; let y = and(x, x);
----
error: no kernel for 'and' on f64[], f64[] at 1:24

# scalar_kernels_for_every_type
type
let a = 2u64; let b = a + a;
----
u64

# reduction_widens
type
let x = [1u8, 2u8]; let s = sum(x);
----
u64

# if_rules
type
let r = if 1.0 < 2.0 { 1.0 } else { 2.0 };
----
f64

type
let r = if 1.0 { 1.0 } else { 2.0 };
----
error: if condition must be bool or bool[], got f64 at 1:12

type
let r = if true { 1.0 } else { 2 };
----
error: if branch types differ: f64 and i64 at 1:9

type
let m = [true]; let r = if m { 1.0 } else { 2.0 };
----
f64[]

type
let m = [true]; let r = if m { [1i8] } else { [2i8] };
----
error: no kernel for 'if' on bool[], i8[], i8[] at 1:25

# array_literal_rules
type
let a = [1.0, 2];
----
error: array elements must all have the same type, found f64 and i64 at 1:15

# let_annotation_must_match
type
let x: f64[] = [1.0];
----
f64[]

type
let x: f64 = [1.0];
----
error: 'x' is declared f64 but its value is f64[] at 1:1

# input_and_export
type
input x: f64[]; export s = sum(x);
----
f64

# input_no_implicit_conversion
type
input x: f64[]; let y = x * 2;
----
error: no implicit conversion: f64[] * i64 at 1:27

# export_name_visible_later
type
export a = 1.0; let b = a + a;
----
f64

# duplicate_input_and_export_are_rejected
type
input x: f64[]; input x: i64[];
----
error: input 'x' is declared twice at 1:17

type
export a = 1.0; export a = 2.0;
----
error: export 'a' is declared twice at 1:17

# An input and an export are different namespaces of the host interface.
type
input a: f64; export b = a; let b = 1.0;
----
f64

# load_and_print_top_level_only
type
let a = load_f64("x.bin");
----
f64[]

type
fn f(a: f64) -> f64 { sum(load_f64("x")) }
----
error: 'load_f64' is only allowed at top level at 1:27

type
let a = map([1.0], |v| sum(load_f64("x")));
----
error: 'sum' cannot be used inside a lambda at 1:24
