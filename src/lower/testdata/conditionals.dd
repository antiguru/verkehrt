# Conditionals: lazy scalar conditions, selects, and hoisting around branches.

# scalar_condition_if_is_lazy
lower mode=run
let x = [1.0]; print(if sum(x) > 0.0 { x } else { x + x });
----
bind x = L_c
print if(gt(reduce_add(L_x), L_c), L_x, add(L_x, L_x))

# mask_condition_if_and_lambda_if_select
lower mode=run
let x = [1.0]; print(if x > 0.0 { 1.0 } else { 0.0 });
----
bind x = L_c
print select(gt(L_x, bcast(L_c)), bcast(L_c), bcast(L_c))

# A condition on a captured scalar is uniform, so the lambda if is lazy, and its scalar branch
# fills to the length of the lambda parameter.
lower mode=run
let x = [1.0]; let s = sum(x); print(map(x, |v| if s > 0.0 { v } else { 0.0 }));
----
bind x = L_c
print if(gt(reduce_add(L_x), L_c), L_x, fill(length(L_x), L_c))

# repeated_subterm_in_branch_is_not_hoisted
lower mode=run
let x = [1.0]; print(if sum(x) > 0.0 { sum(x + x) + sum(x + x) } else { 0.0 });
----
bind x = L_c
print if(gt(reduce_add(L_x), L_c), add(reduce_add(add(L_x, L_x)), reduce_add(add(L_x, L_x))), L_c)

# Repeats in the condition run unconditionally and are hoisted.
lower mode=run
let x = [1.0]; print(if sum(x) > sum(x) { sum(x) } else { 0.0 });
----
bind x = L_c
bind _t0 = reduce_add(L_x)
print if(gt(L_t0, L_t0), reduce_add(L_x), L_c)

# repeated_conditional_is_hoisted_whole
lower mode=run
let x = [1.0]; let c = if sum(x) > 0.0 { 1.0 } else { 2.0 }; print(c + c);
----
bind x = L_c
bind c = if(gt(reduce_add(L_x), L_c), L_c, L_c)
print add(L_c, L_c)

lower mode=run
fn f(x: f64[]) -> f64 { if sum(x) > 0.0 { 1.0 } else { 2.0 } } let x = [1.0]; print(f(x) + f(x));
----
bind x = L_c
bind _t0 = if(gt(reduce_add(L_x), L_c), L_c, L_c)
print add(L_t0, L_t0)

# single_use_let_inlines_into_branch
lower mode=run
let x = [1.0]; let t = sum(x + x); print(if true { t } else { 0.0 });
----
bind x = L_c
print if(L_c, reduce_add(add(L_x, L_x)), L_c)
