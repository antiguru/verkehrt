# A broadcast scalar moves out of an integer sum: `sum(x + k)` becomes
# `sum(x) + length(x) * k`, and likewise for `-` in both operand orders and `*`. Each program
# is planned with fusion on and off, and fusion off keeps the summed array.

plan fusion=on
let a = [1, 2, 3]; print(sum(a + 3));
----
add_i64_s: (add_i64_s (reduce_add_i64 a) (mul_i64_s (length_i64 a) 3))

plan fusion=off
let a = [1, 2, 3]; print(sum(a + 3));
----
reduce_add_i64: (reduce_add_i64 (add_i64 a 3))

plan fusion=on
let a = [1, 2, 3]; print(sum(3 + a));
----
add_i64_s: (add_i64_s (reduce_add_i64 a) (mul_i64_s (length_i64 a) 3))

plan fusion=off
let a = [1, 2, 3]; print(sum(3 + a));
----
reduce_add_i64: (reduce_add_i64 (add_i64 3 a))

plan fusion=on
let a = [1, 2, 3]; print(sum(a - 3));
----
sub_i64_s: (sub_i64_s (reduce_add_i64 a) (mul_i64_s (length_i64 a) 3))

plan fusion=off
let a = [1, 2, 3]; print(sum(a - 3));
----
reduce_add_i64: (reduce_add_i64 (sub_i64 a 3))

plan fusion=on
let a = [1, 2, 3]; print(sum(3 - a));
----
sub_i64_s: (sub_i64_s (mul_i64_s 3 (length_i64 a)) (reduce_add_i64 a))

plan fusion=off
let a = [1, 2, 3]; print(sum(3 - a));
----
reduce_add_i64: (reduce_add_i64 (sub_i64 3 a))

plan fusion=on
let a = [1, 2, 3]; print(sum(a * 3));
----
mul_i64_s: (mul_i64_s (reduce_add_i64 a) 3)

plan fusion=off
let a = [1, 2, 3]; print(sum(a * 3));
----
reduce_add_i64: (reduce_add_i64 (mul_i64 a 3))

plan fusion=on
let a = [1, 2, 3]; print(sum(3 * a));
----
mul_i64_s: (mul_i64_s (reduce_add_i64 a) 3)

plan fusion=off
let a = [1, 2, 3]; print(sum(3 * a));
----
reduce_add_i64: (reduce_add_i64 (mul_i64 3 a))

# The count is cast to the element type, so the product and the sum wrap in it.
plan fusion=on
let a = [1u64, 2u64, 3u64]; print(sum(a + 3u64));
----
add_u64_s: (add_u64_s (reduce_add_u64 a) (mul_u64_s (cast_i64_u64_s (length_u64 a)) 3))

plan fusion=off
let a = [1u64, 2u64, 3u64]; print(sum(a + 3u64));
----
reduce_add_u64: (reduce_add_u64 (add_u64 a 3))

plan fusion=on
let a = [1u64, 2u64, 3u64]; print(sum(3u64 + a));
----
add_u64_s: (add_u64_s (reduce_add_u64 a) (mul_u64_s (cast_i64_u64_s (length_u64 a)) 3))

plan fusion=off
let a = [1u64, 2u64, 3u64]; print(sum(3u64 + a));
----
reduce_add_u64: (reduce_add_u64 (add_u64 3 a))

plan fusion=on
let a = [1u64, 2u64, 3u64]; print(sum(a - 3u64));
----
sub_u64_s: (sub_u64_s (reduce_add_u64 a) (mul_u64_s (cast_i64_u64_s (length_u64 a)) 3))

plan fusion=off
let a = [1u64, 2u64, 3u64]; print(sum(a - 3u64));
----
reduce_add_u64: (reduce_add_u64 (sub_u64 a 3))

plan fusion=on
let a = [1u64, 2u64, 3u64]; print(sum(3u64 - a));
----
sub_u64_s: (sub_u64_s (mul_u64_s 3 (cast_i64_u64_s (length_u64 a))) (reduce_add_u64 a))

plan fusion=off
let a = [1u64, 2u64, 3u64]; print(sum(3u64 - a));
----
reduce_add_u64: (reduce_add_u64 (sub_u64 3 a))

plan fusion=on
let a = [1u64, 2u64, 3u64]; print(sum(a * 3u64));
----
mul_u64_s: (mul_u64_s (reduce_add_u64 a) 3)

plan fusion=off
let a = [1u64, 2u64, 3u64]; print(sum(a * 3u64));
----
reduce_add_u64: (reduce_add_u64 (mul_u64 a 3))

plan fusion=on
let a = [1u64, 2u64, 3u64]; print(sum(3u64 * a));
----
mul_u64_s: (mul_u64_s (reduce_add_u64 a) 3)

plan fusion=off
let a = [1u64, 2u64, 3u64]; print(sum(3u64 * a));
----
reduce_add_u64: (reduce_add_u64 (mul_u64 3 a))

# `sum` widens `i32` to `i64` after each element wraps in `i32`, so no rewrite is exact.
plan fusion=on
let a = [1i32, 2i32, 3i32]; print(sum(a + 3i32));
----
reduce_add_i32: (reduce_add_i32 (add_i32 a 3))

plan fusion=off
let a = [1i32, 2i32, 3i32]; print(sum(a + 3i32));
----
reduce_add_i32: (reduce_add_i32 (add_i32 a 3))

plan fusion=on
let a = [1i32, 2i32, 3i32]; print(sum(3i32 + a));
----
reduce_add_i32: (reduce_add_i32 (add_i32 3 a))

plan fusion=off
let a = [1i32, 2i32, 3i32]; print(sum(3i32 + a));
----
reduce_add_i32: (reduce_add_i32 (add_i32 3 a))

plan fusion=on
let a = [1i32, 2i32, 3i32]; print(sum(a - 3i32));
----
reduce_add_i32: (reduce_add_i32 (sub_i32 a 3))

plan fusion=off
let a = [1i32, 2i32, 3i32]; print(sum(a - 3i32));
----
reduce_add_i32: (reduce_add_i32 (sub_i32 a 3))

plan fusion=on
let a = [1i32, 2i32, 3i32]; print(sum(3i32 - a));
----
reduce_add_i32: (reduce_add_i32 (sub_i32 3 a))

plan fusion=off
let a = [1i32, 2i32, 3i32]; print(sum(3i32 - a));
----
reduce_add_i32: (reduce_add_i32 (sub_i32 3 a))

plan fusion=on
let a = [1i32, 2i32, 3i32]; print(sum(a * 3i32));
----
reduce_add_i32: (reduce_add_i32 (mul_i32 a 3))

plan fusion=off
let a = [1i32, 2i32, 3i32]; print(sum(a * 3i32));
----
reduce_add_i32: (reduce_add_i32 (mul_i32 a 3))

plan fusion=on
let a = [1i32, 2i32, 3i32]; print(sum(3i32 * a));
----
reduce_add_i32: (reduce_add_i32 (mul_i32 3 a))

plan fusion=off
let a = [1i32, 2i32, 3i32]; print(sum(3i32 * a));
----
reduce_add_i32: (reduce_add_i32 (mul_i32 3 a))

# `sum` widens `u8` to `u64` after each element wraps in `u8`, so no rewrite is exact.
plan fusion=on
let a = [1u8, 2u8, 3u8]; print(sum(a + 3u8));
----
reduce_add_u8: (reduce_add_u8 (add_u8 a 3))

plan fusion=off
let a = [1u8, 2u8, 3u8]; print(sum(a + 3u8));
----
reduce_add_u8: (reduce_add_u8 (add_u8 a 3))

plan fusion=on
let a = [1u8, 2u8, 3u8]; print(sum(3u8 + a));
----
reduce_add_u8: (reduce_add_u8 (add_u8 3 a))

plan fusion=off
let a = [1u8, 2u8, 3u8]; print(sum(3u8 + a));
----
reduce_add_u8: (reduce_add_u8 (add_u8 3 a))

plan fusion=on
let a = [1u8, 2u8, 3u8]; print(sum(a - 3u8));
----
reduce_add_u8: (reduce_add_u8 (sub_u8 a 3))

plan fusion=off
let a = [1u8, 2u8, 3u8]; print(sum(a - 3u8));
----
reduce_add_u8: (reduce_add_u8 (sub_u8 a 3))

plan fusion=on
let a = [1u8, 2u8, 3u8]; print(sum(3u8 - a));
----
reduce_add_u8: (reduce_add_u8 (sub_u8 3 a))

plan fusion=off
let a = [1u8, 2u8, 3u8]; print(sum(3u8 - a));
----
reduce_add_u8: (reduce_add_u8 (sub_u8 3 a))

plan fusion=on
let a = [1u8, 2u8, 3u8]; print(sum(a * 3u8));
----
reduce_add_u8: (reduce_add_u8 (mul_u8 a 3))

plan fusion=off
let a = [1u8, 2u8, 3u8]; print(sum(a * 3u8));
----
reduce_add_u8: (reduce_add_u8 (mul_u8 a 3))

plan fusion=on
let a = [1u8, 2u8, 3u8]; print(sum(3u8 * a));
----
reduce_add_u8: (reduce_add_u8 (mul_u8 3 a))

plan fusion=off
let a = [1u8, 2u8, 3u8]; print(sum(3u8 * a));
----
reduce_add_u8: (reduce_add_u8 (mul_u8 3 a))

# Float arithmetic does not associate, so no rewrite fires.
plan fusion=on
print(sum(x + 2.0));
----
reduce_add_f64: (reduce_add_f64 (add_f64 x 2.0))

plan fusion=on
print(sum(2.0 - x));
----
reduce_add_f64: (reduce_add_f64 (sub_f64 2.0 x))
